# Environment Configuration Template
# Copy this file to .env and update with your actual values

# =============================================================================
# API Configuration
# =============================================================================

# API Host URL - Base URL for backend API endpoints
# In AWS deployments, this should be loaded from AWS Systems Manager Parameter Store
# For local development, use localhost
# For React apps, use REACT_APP_ prefix for client-side environment variables
REACT_APP_API_HOST=http://localhost:3000
API_HOST=http://localhost:3000

# =============================================================================
# AWS Configuration (for production deployments)
# =============================================================================

# AWS Region
AWS_REGION=us-east-1

# AWS S3 Configuration (for static asset storage)
AWS_S3_BUCKET=my-app-assets
AWS_S3_BASE_PATH=assets
AWS_S3_PUBLIC_PATH=https://my-app-assets.s3.amazonaws.com/

# AWS Credentials (use IAM roles in production instead of hardcoded credentials)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# =============================================================================
# Database Configuration
# =============================================================================

# MongoDB Connection
MONGODB_URL=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_COLLECTION=test

# =============================================================================
# Application Configuration
# =============================================================================

# Node Environment (development, staging, production)
NODE_ENV=development

# Server Port
PORT=8050

# Build Output Directory
BUILD_OUTPUT_DIR=dist

# =============================================================================
# AWS Systems Manager Parameter Store Configuration
# =============================================================================

# Parameter Store Path Prefix (for environment-specific parameters)
# Example: /myapp/dev, /myapp/staging, /myapp/prod
AWS_PARAMETER_STORE_PREFIX=/myapp/dev

# Enable Parameter Store integration (true/false)
USE_PARAMETER_STORE=false

# =============================================================================
# Security Configuration
# =============================================================================

# Session Secret (use a strong random string in production)
SESSION_SECRET=your-session-secret-here

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8050

# =============================================================================
# Logging Configuration
# =============================================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Enable JSON logging for cloud environments
JSON_LOGGING=false

# =============================================================================
# Notes
# =============================================================================

# 1. Never commit .env file to version control
# 2. Use AWS Systems Manager Parameter Store for production secrets
# 3. Use IAM roles instead of hardcoded AWS credentials
# 4. Rotate secrets regularly
# 5. Use different values for each environment (dev, staging, prod)
