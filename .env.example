# Azure Cloud Configuration for Express-React-TypeScript Application
# Copy this file to .env and configure with your Azure credentials

# ============================================================================
# Azure Blob Storage Configuration (for persistent file storage)
# ============================================================================
# Replace __dirname-based file operations with Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your-storage-account>;AccountKey=<your-key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=app-data

# ============================================================================
# Webpack Build Configuration
# ============================================================================
# Output directory for webpack builds (can be Azure-mounted volume)
WEBPACK_OUTPUT_DIR=dist
PUBLIC_PATH=/

# ============================================================================
# Development Server Configuration
# ============================================================================
DEV_SERVER_PORT=3000
API_PROXY_TARGET=http://localhost:8050

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=production
PORT=8050

# ============================================================================
# MongoDB Configuration (for Azure Cosmos DB with MongoDB API)
# ============================================================================
MONGODB_URL=<your-cosmos-db-connection-string>
MONGODB_PORT=10255
MONGODB_USERNAME=<your-cosmos-db-username>
MONGODB_PASSWORD=<your-cosmos-db-password>
MONGODB_COLLECTION=test
MONGODB_SSL=true

# ============================================================================
# Azure-specific Settings
# ============================================================================
# Azure App Service automatically sets these
WEBSITE_HOSTNAME=<your-app>.azurewebsites.net
WEBSITE_SITE_NAME=<your-app-name>

# ============================================================================
# Logging and Monitoring
# ============================================================================
LOG_LEVEL=info
ENABLE_AZURE_INSIGHTS=true
