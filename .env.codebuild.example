# AWS CodeBuild Environment Configuration
# This file documents the environment variables required for CSS minification and S3/CloudFront deployment
# Copy these settings to your AWS CodeBuild project environment variables

# ============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# ============================================================================

# Node.js Environment
# Set to 'production' to enable CSS minification via CSSNano and webpack optimizations
NODE_ENV=production

# AWS S3 Configuration
# Target S3 bucket for deploying minified CSS and static assets
S3_BUCKET=my-app-static-assets

# AWS Region
# Region where your S3 bucket and CloudFront distribution are located
AWS_REGION=us-east-1

# ============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# ============================================================================

# CloudFront Distribution ID
# If provided, the build will automatically invalidate CloudFront cache after deployment
# Find this in AWS Console → CloudFront → Distributions
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# S3 Base Path
# Base path within the S3 bucket for organizing assets (default: 'assets')
AWS_S3_BASE_PATH=assets

# Build Output Directory
# Local directory where webpack/Next.js outputs build artifacts (default: 'dist' or '.next')
BUILD_OUTPUT_DIR=.next

# AWS Build Output Directory
# Alternative environment variable for build output (used in some AWS services)
AWS_BUILD_OUTPUT_DIR=.next

# CDN Public Path
# Public URL path for accessing assets via CloudFront
# Example: https://d1234567890abc.cloudfront.net/
AWS_CDN_PUBLIC_PATH=https://d1234567890abc.cloudfront.net/

# S3 Public Path
# Direct S3 URL for accessing assets (if not using CloudFront)
# Example: https://my-app-static-assets.s3.amazonaws.com/
AWS_S3_PUBLIC_PATH=https://my-app-static-assets.s3.amazonaws.com/

# ============================================================================
# AWS CREDENTIALS (Managed by CodeBuild IAM Role)
# ============================================================================

# These are automatically provided by AWS CodeBuild service role
# DO NOT set these manually in CodeBuild environment variables
# AWS_ACCESS_KEY_ID=<automatically-provided>
# AWS_SECRET_ACCESS_KEY=<automatically-provided>
# AWS_SESSION_TOKEN=<automatically-provided>

# ============================================================================
# CODEBUILD PROJECT CONFIGURATION EXAMPLE
# ============================================================================

# To create a CodeBuild project with these environment variables using AWS CLI:
#
# aws codebuild create-project \
#   --name my-app-build \
#   --source type=GITHUB,location=https://github.com/myorg/myapp.git \
#   --artifacts type=S3,location=my-app-artifacts \
#   --environment type=LINUX_CONTAINER,image=aws/codebuild/standard:5.0,computeType=BUILD_GENERAL1_SMALL \
#   --service-role arn:aws:iam::123456789012:role/CodeBuildServiceRole \
#   --environment-variables \
#     name=NODE_ENV,value=production,type=PLAINTEXT \
#     name=S3_BUCKET,value=my-app-static-assets,type=PLAINTEXT \
#     name=AWS_REGION,value=us-east-1,type=PLAINTEXT \
#     name=CLOUDFRONT_DISTRIBUTION_ID,value=E1234567890ABC,type=PLAINTEXT

# ============================================================================
# TERRAFORM CONFIGURATION EXAMPLE
# ============================================================================

# If using Terraform to manage CodeBuild:
#
# resource "aws_codebuild_project" "app_build" {
#   name          = "my-app-build"
#   service_role  = aws_iam_role.codebuild_role.arn
#
#   environment {
#     compute_type                = "BUILD_GENERAL1_SMALL"
#     image                       = "aws/codebuild/standard:5.0"
#     type                        = "LINUX_CONTAINER"
#     image_pull_credentials_type = "CODEBUILD"
#
#     environment_variable {
#       name  = "NODE_ENV"
#       value = "production"
#     }
#
#     environment_variable {
#       name  = "S3_BUCKET"
#       value = "my-app-static-assets"
#     }
#
#     environment_variable {
#       name  = "AWS_REGION"
#       value = "us-east-1"
#     }
#
#     environment_variable {
#       name  = "CLOUDFRONT_DISTRIBUTION_ID"
#       value = "E1234567890ABC"
#     }
#   }
#
#   source {
#     type      = "GITHUB"
#     location  = "https://github.com/myorg/myapp.git"
#     buildspec = "buildspec.yml"
#   }
#
#   artifacts {
#     type     = "S3"
#     location = "my-app-artifacts"
#   }
# }

# ============================================================================
# AWS SYSTEMS MANAGER PARAMETER STORE (Recommended for Secrets)
# ============================================================================

# For sensitive configuration, use AWS Systems Manager Parameter Store:
#
# Store parameters:
# aws ssm put-parameter --name /myapp/s3-bucket --value my-app-static-assets --type String
# aws ssm put-parameter --name /myapp/cloudfront-id --value E1234567890ABC --type String
#
# Reference in buildspec.yml:
# phases:
#   pre_build:
#     commands:
#       - export S3_BUCKET=$(aws ssm get-parameter --name /myapp/s3-bucket --query Parameter.Value --output text)
#       - export CLOUDFRONT_DISTRIBUTION_ID=$(aws ssm get-parameter --name /myapp/cloudfront-id --query Parameter.Value --output text)

# ============================================================================
# IAM ROLE PERMISSIONS REQUIRED
# ============================================================================

# The CodeBuild service role must have these permissions:
#
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Effect": "Allow",
#       "Action": [
#         "s3:PutObject",
#         "s3:PutObjectAcl",
#         "s3:GetObject",
#         "s3:ListBucket"
#       ],
#       "Resource": [
#         "arn:aws:s3:::my-app-static-assets",
#         "arn:aws:s3:::my-app-static-assets/*"
#       ]
#     },
#     {
#       "Effect": "Allow",
#       "Action": [
#         "cloudfront:CreateInvalidation",
#         "cloudfront:GetInvalidation"
#       ],
#       "Resource": "arn:aws:cloudfront::*:distribution/*"
#     },
#     {
#       "Effect": "Allow",
#       "Action": [
#         "ssm:GetParameter",
#         "ssm:GetParameters"
#       ],
#       "Resource": "arn:aws:ssm:*:*:parameter/myapp/*"
#     },
#     {
#       "Effect": "Allow",
#       "Action": [
#         "logs:CreateLogGroup",
#         "logs:CreateLogStream",
#         "logs:PutLogEvents"
#       ],
#       "Resource": "arn:aws:logs:*:*:*"
#     }
#   ]
# }

# ============================================================================
# VERIFICATION
# ============================================================================

# After configuring environment variables, verify the build:
# 1. Trigger a build in AWS CodeBuild
# 2. Check build logs for "CSS minification enabled"
# 3. Verify minified CSS files in S3 bucket
# 4. Test CloudFront delivery of minified assets
# 5. Confirm cache headers are set correctly
