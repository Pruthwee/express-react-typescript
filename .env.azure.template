# Azure Environment Configuration Template
# Copy this file to .env for local development
# For Azure deployment, set these as Application Settings

# Server Configuration
NODE_ENV=production
PORT=8050

# SSR Configuration
SSR_ENABLED=true
SSR_CACHE_ENABLED=false
SSR_CACHE_TTL=300

# Webpack Configuration
WEBPACK_OUTPUT_DIR=dist
PUBLIC_PATH=/
DEV_SERVER_PORT=3000
API_PROXY_TARGET=http://localhost:8050

# Database Configuration (MongoDB)
# For Azure, use Azure Cosmos DB with MongoDB API
MONGODB_URI=mongodb://localhost:27017/express-react-app
DB_NAME=express-react-app

# Azure Storage Configuration (if using Azure Blob Storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

# Logging
LOG_LEVEL=info

# Security
# Generate a secure session secret for production
SESSION_SECRET=change-this-in-production

# CORS Configuration
CORS_ORIGIN=*

# Azure-Specific Settings
AZURE_REGION=eastus
AZURE_RESOURCE_GROUP=
AZURE_APP_NAME=

# Application Insights (optional)
APPINSIGHTS_INSTRUMENTATIONKEY=
